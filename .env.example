# ============================================
# O2O 红包核销系统 —— 环境变量清单（示例）
# 说明：本文件只作为变量参照，复制为 .env 后按需修改；
#       脚本本身不会自动加载 .env，请按下面对应方式注入环境变量。
#
# 注入方式：
#   macOS / Linux（bash）：
#       set -a; source .env; set +a
#   Windows（PowerShell）：
#       Get-Content .env | Where-Object {$_ -match '^\w+='} | ForEach-Object {
#           $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
#   Windows（cmd，临时）：
#       set REDPACKET_DB=data\persons\张三\redpacket.db
# ============================================

# ---------- 数据库位置（最常用）----------
# 指向你自己的库；不设则默认使用仓库根的 data/redpacket.db（多人共用一台机器时别这么用）
# 由 scripts/init_person.py --name 你的名字 自动生成对应的库文件
REDPACKET_DB=data/persons/张三/redpacket.db

# ---------- 看板服务 ----------
# 端口被占用时改这里，或直接用 --port 参数覆盖
PORT=8899
# 127.0.0.1 = 只有本机能访问；0.0.0.0 = 同一局域网内的同事也能访问
HOST=127.0.0.1

# ---------- 解释器（一键脚本用）----------
# Windows 若 python3 不可用，改成 python
PYTHON=python3
